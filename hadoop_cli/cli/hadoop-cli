  # :command.required_flags_filter
  # :command.catch_all_filter
  # :command.default_assignments
  [[ -n ${args[service]:-} ]] || args[service]="all"
  # :command.whitelist_filter
  if [[ ! ${args[service]} =~ ^(datanode|all)$ ]]; then
    printf "%s\n" "service must be one of: datanode, all"
    exit 1
  fi
  # :command.user_filter
}

# :command.parse_requirements
hadoop_cli_pwd_parse_requirements() {
  # :command.fixed_flags_filter
  case "${1:-}" in
  --help | -h )
    long_usage=yes
    hadoop_cli_pwd_usage
    exit
    ;;

  esac
  # :command.environment_variables_filter
  # :command.dependencies_filter
  # :command.command_filter
  action="pwd"
  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

    -?* )
      printf "invalid option: %s\n" "$key"
      exit 1
      ;;

    * )
      # :command.parse_requirements_case
      # :command.parse_requirements_case_simple
      printf "invalid argument: %s\n" "$key"
      exit 1
      ;;

    esac
  done
  # :command.required_args_filter
  # :command.required_flags_filter
  # :command.catch_all_filter
  # :command.default_assignments
  # :command.whitelist_filter
  # :command.user_filter
}

# :command.initialize
initialize() {
  version="0.1.0"
  long_usage=''
  set -e

  # src/initialize.sh
  # Code here runs inside the initialize() function
  # Use it for anything that you need to run before any other function, like
  # setting environment vairables:
  # CONFIG_FILE=settings.ini
  #
  # Feel free to empty (but not delete) this file.

  service_name=logan
  tail_line_number=100
  docker_compose_file_path=""
  docker_compose_flags=""
}

# :command.run
run() {
  declare -A args=()
  declare -a other_args=()
  declare -a input=()
  normalize_input "$@"
  parse_requirements "${input[@]}"

  if [[ $action == "up" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_up_usage
    else
      hadoop_cli_up_command
    fi

  elif [[ $action == "down" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_down_usage
    else
      hadoop_cli_down_command
    fi

  elif [[ $action == "restart" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_restart_usage
    else
      hadoop_cli_restart_command
    fi

  elif [[ $action == "logs" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_logs_usage
    else
      hadoop_cli_logs_command
    fi

  elif [[ $action == "exec" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_exec_usage
    else
      hadoop_cli_exec_command
    fi

  elif [[ $action == "build" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_build_usage
    else
      hadoop_cli_build_command
    fi

  elif [[ $action == "pwd" ]]; then
    if [[ ${args[--help]:-} ]]; then
      long_usage=yes
      hadoop_cli_pwd_usage
    else
      hadoop_cli_pwd_command
    fi

  elif [[ $action == "root" ]]; then
    root_command
  fi
}

initialize
run "$@"
