# :command.parse_requirements
parse_requirements() {
  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        hadoop_cli_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.environment_variables_filter
  # :command.environment_variables_default
  export BASE_PATH="${BASE_PATH:-/opt/hadoop/}"

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    up)
      action="up"
      shift
      hadoop_cli_up_parse_requirements "$@"
      shift $#
      ;;

    down)
      action="down"
      shift
      hadoop_cli_down_parse_requirements "$@"
      shift $#
      ;;

    restart)
      action="restart"
      shift
      hadoop_cli_restart_parse_requirements "$@"
      shift $#
      ;;

    logs)
      action="logs"
      shift
      hadoop_cli_logs_parse_requirements "$@"
      shift $#
      ;;

    exec)
      action="exec"
      shift
      hadoop_cli_exec_parse_requirements "$@"
      shift $#
      ;;

    build)
      action="build"
      shift
      hadoop_cli_build_parse_requirements "$@"
      shift $#
      ;;

    pwd)
      action="pwd"
      shift
      hadoop_cli_pwd_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      hadoop_cli_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

