# :command.initialize
initialize() {
  version="0.1.0"
  long_usage=''
  set -e

  # :command.environment_variables_default
  export BASE_PATH="${BASE_PATH:-/opt/hadoop/}"

}

# :command.run
run() {
  declare -A args=()
  declare -A deps=()
  declare -a other_args=()
  declare -a input=()
  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "up") hadoop_cli_up_command ;;
    "down") hadoop_cli_down_command ;;
    "restart") hadoop_cli_restart_command ;;
    "logs") hadoop_cli_logs_command ;;
    "exec") hadoop_cli_exec_command ;;
    "build") hadoop_cli_build_command ;;
    "pwd") hadoop_cli_pwd_command ;;
  esac
}

initialize
run "$@"
