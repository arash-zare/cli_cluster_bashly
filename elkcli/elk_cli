          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.required_args_filter
  if [[ -z ${args['service']+x} ]]; then
    printf "missing required argument: SERVICE\nusage: elk_cli exec SERVICE COMMAND\n" >&2
    exit 1
  fi
  if [[ -z ${args['command']+x} ]]; then
    printf "missing required argument: COMMAND\nusage: elk_cli exec SERVICE COMMAND\n" >&2
    exit 1
  fi

  # :command.whitelist_filter
  if [[ -n ${args['service']} ]] && [[ ! ${args['service']} =~ ^(es|logstash|kibana)$ ]]; then
    printf "%s\n" "service must be one of: es, logstash, kibana" >&2
    exit 1
  fi

}

# :command.initialize
initialize() {
  version="0.1.0"
  long_usage=''
  set -e

  # :command.environment_variables_default
  export BASE_PATH="${BASE_PATH:-/opt/elk/}"

}

# :command.run
run() {
  declare -A args=()
  declare -A deps=()
  declare -a other_args=()
  declare -a input=()
  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "ps") elk_cli_ps_command ;;
    "up") elk_cli_up_command ;;
    "down") elk_cli_down_command ;;
    "stop") elk_cli_stop_command ;;
    "logs") elk_cli_logs_command ;;
    "restart") elk_cli_restart_command ;;
    "exec") elk_cli_exec_command ;;
  esac
}

initialize
run "$@"
